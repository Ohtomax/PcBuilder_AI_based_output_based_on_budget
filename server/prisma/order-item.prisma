// ─────────────────────────────────────────────
// Module 4 — Order Line Items
// Price is captured at purchase time (snapshot)
// ─────────────────────────────────────────────

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int
  productId    Int
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)  // price at time of purchase — immutable
  serialNumber String? @db.VarChar(100)   // for used/refurbished — warranty tracking
  condition    String? @db.VarChar(50)    // e.g. "Brand New", "Grade A", "Grade B"
  subtotal     Decimal @db.Decimal(12, 2) // unitPrice * quantity

  // Relations
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      product @relation(fields: [productId], references: [id_product])

  @@index([orderId])
  @@index([productId])
}

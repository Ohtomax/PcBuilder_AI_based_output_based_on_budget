model Order {
  id_order        Int          @id @default(autoincrement())
  orderNumber     String       @unique @default(cuid())
  userId          String       @db.VarChar(255)
  cartId          Int          @unique
  status          status_order @default(PENDING)
  currency        String       @default("PHP") @db.VarChar(3)
  subtotal        Decimal      @db.Decimal(12, 2)
  shippingFee     Decimal      @default(0) @db.Decimal(12, 2)
  discount        Decimal      @default(0) @db.Decimal(12, 2)
  total           Decimal      @db.Decimal(12, 2)
  deliveryDetails String?      @db.Text
  createdAt       DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(6)

  user       Users       @relation(fields: [userId], references: [firebase_uid], onDelete: Restrict)
  cart       Cart        @relation(fields: [cartId], references: [id_cart], onDelete: Restrict)
  orderItems OrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

enum status_order {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

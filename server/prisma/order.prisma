// ─────────────────────────────────────────────
// Module 4 — Orders & Fulfillment
// ─────────────────────────────────────────────

model Order {
  id                Int          @id @default(autoincrement())
  userId            String       @db.VarChar(255)
  status            OrderStatus  @default(PENDING_PAYMENT)
  totalAmount       Decimal      @db.Decimal(12, 2)
  shippingName      String       @db.VarChar(255)
  shippingAddress   String       @db.Text
  shippingCity      String       @db.VarChar(100)
  shippingProvince  String       @db.VarChar(100)
  shippingZip       String       @db.VarChar(20)
  shippingPhone     String       @db.VarChar(20)
  paymentMethod     String       @db.VarChar(50)   // e.g. "GCash", "Credit Card", "COD"
  paymentReference  String?      @db.VarChar(100)  // payment gateway transaction ID
  paidAt            DateTime?    @db.Timestamptz(6)
  trackingNumber    String?      @db.VarChar(100)
  courier           String?      @db.VarChar(50)
  shippedAt         DateTime?    @db.Timestamptz(6)
  deliveredAt       DateTime?    @db.Timestamptz(6)
  notes             String?      @db.Text
  createdAt         DateTime     @default(now())   @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt        @db.Timestamptz(6)

  // Relations
  user              users        @relation(fields: [userId], references: [firebase_uid])
  items             OrderItem[]
  cancellation      Cancellation?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

enum OrderStatus {
  PENDING_PAYMENT  // order created, awaiting payment
  PROCESSING       // payment confirmed, preparing shipment
  TO_SHIP          // packed, ready to hand to courier
  SHIPPED          // in transit
  DELIVERED        // received by customer
  CANCELLED        // cancelled (see Cancellation table)
}

model Cancellation {
  id              Int          @id @default(autoincrement())
  orderId         Int          @unique
  reason          String       @db.Text
  cancelledBy     CancelledBy
  refundStatus    RefundStatus @default(PENDING)
  refundAmount    Decimal?     @db.Decimal(12, 2)
  refundReference String?      @db.VarChar(100)
  cancelledAt     DateTime     @default(now()) @db.Timestamptz(6)
  refundedAt      DateTime?    @db.Timestamptz(6)
  notes           String?      @db.Text

  order           Order        @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

enum CancelledBy {
  CUSTOMER
  ADMIN
  SYSTEM
}

enum RefundStatus {
  NOT_APPLICABLE
  PENDING
  PROCESSING
  REFUNDED
  FAILED
}

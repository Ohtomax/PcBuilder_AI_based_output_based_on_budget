model Cart {
  id_cart   Int         @id @default(autoincrement())
  userId    String
  status    status_cart @default(ACTIVE)
  createdAt DateTime    @default(now()) @db.Timestamptz(6)

  user      Users      @relation(fields: [userId], references: [firebase_uid], onDelete: Restrict)
  cartItems CartItem[]
  order     Order?

  @@index([userId, status])
}

enum status_cart {
  ACTIVE
  INACTIVE
  MERGED
  CONVERTED
}

// ─────────────────────────────────────────────
// Module 3 — AI PC Builder Sessions & Saved Builds
// ─────────────────────────────────────────────

model PcBuild {
  id          Int         @id @default(autoincrement())
  userId      String      @db.VarChar(255)
  title       String      @db.VarChar(100) @default("My Build")
  budget      Decimal     @db.Decimal(12, 2)
  useCase     String      @db.VarChar(100)   // e.g. "Gaming", "Video Editing", "Office"
  aesthetic   String?     @db.VarChar(100)   // e.g. "RGB", "Minimalist"
  status      BuildStatus @default(DRAFT)
  totalPrice  Decimal     @db.Decimal(12, 2) @default(0)
  aiNotes     String?     @db.Text           // AI reasoning for the full build
  createdAt   DateTime    @default(now())    @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt         @db.Timestamptz(6)

  // Relations
  user        users       @relation(fields: [userId], references: [firebase_uid], onDelete: Cascade)
  items       PcBuildItem[]

  @@index([userId])
  @@index([status])
}

enum BuildStatus {
  DRAFT    // AI is still generating / user is tweaking
  SAVED    // User explicitly saved the build
  IN_CART  // Build has been moved into the shopping cart
  ORDERED  // An order was placed from this build
}
